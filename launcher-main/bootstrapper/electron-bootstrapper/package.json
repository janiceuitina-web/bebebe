{
  "name": "robbob-bootstrapper",
  "version": "1.0.0",
  "description": "RobBob Launcher - Установщик",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "author": "RobBob Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.robbob.bootstrapper",
    "productName": "RobBob Bootstrapper",
    "copyright": "Copyright © 2024 RobBob",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "RobBob-Bootstrapper.${ext}"
    },
    "portable": {
      "artifactName": "RobBob-Bootstrapper.exe"
    },
    "compression": "maximum",
    "asar": true
  }
}
